# Privacy Browser Agent - Server Configuration
# Copy this file to .env and update values as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
WORKERS=4

# Privacy Settings
ENABLE_PRIVACY_VALIDATION=true
MIN_REDACTION_COVERAGE=0.8
SENSITIVE_DETECTION_THRESHOLD=0.85

# Performance
MAX_CONCURRENT_SESSIONS=100
SCREENSHOT_MAX_SIZE=10485760
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Database (Optional)
DATABASE_URL=sqlite:///./privacy_agent.db
DATABASE_POOL_SIZE=5
DATABASE_POOL_RECYCLE=3600

# Security
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
API_KEY_REQUIRED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false
TELEMETRY_ENABLED=true

# ML Models
VISION_MODEL_PATH=./models/deit-tiny.onnx
MAX_IMAGE_RESOLUTION=1280x720
MODEL_INFERENCE_TIMEOUT=5000

# Logging
LOG_FILE=./logs/server.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_RETENTION_DAYS=30

# Debug
DEBUG=false
PROFILING_ENABLED=false
VERBOSE_LOGGING=false
