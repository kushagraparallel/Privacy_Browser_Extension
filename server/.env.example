# Privacy Browser Agent - Server Configuration
# Copy to .env and fill in your values

# ============================================================================
# GROQ API CONFIGURATION (REQUIRED)
# ============================================================================
# Get your Groq API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for agent reasoning
GROQ_MODEL=mixtral-8x7b-32768

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# ============================================================================
# CORS CONFIGURATION
# For development:
# CORS_ORIGINS=http://localhost:3000,chrome-extension://*
#
# For production, restrict to your specific origins:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# ============================================================================
CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
# Maximum number of steps the agent can take before stopping
MAX_AGENT_STEPS=20

# Action execution timeout (milliseconds)
ACTION_TIMEOUT=30000

# Total agent reasoning timeout (milliseconds)
AGENT_TIMEOUT=60000

# Minimum required redaction coverage for PII (0.0 to 1.0)
MIN_REDACTION_COVERAGE=0.8
RATE_LIMIT_WINDOW=60

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false
TELEMETRY_ENABLED=true

# ML Models
VISION_MODEL_PATH=./models/deit-tiny.onnx
MAX_IMAGE_RESOLUTION=1280x720
MODEL_INFERENCE_TIMEOUT=5000

# Logging
LOG_FILE=./logs/server.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_RETENTION_DAYS=30

# Debug
DEBUG=false
PROFILING_ENABLED=false
VERBOSE_LOGGING=false
